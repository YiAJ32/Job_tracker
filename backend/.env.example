DATABASE_URL=postgresql+psycopg://postgres:<tu-password>@localhost:5432/job_tracker
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=<genera-uno-con: python -c "import secrets;print(secrets.token_urlsafe(48))">
# Duración de la sesión en minutos. Por defecto 7 días (10080); para uso personal podés poner 525600 (1 año)
# JWT_EXPIRE_MINUTES=10080
# Correo para enviar el código de confirmación. Si SMTP_HOST queda vacío, el código se muestra en la consola.
# Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 y una "contraseña de aplicación" en SMTP_PASSWORD
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
